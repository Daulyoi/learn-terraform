# Local .terraform directories (contains provider plugins and modules)
**/.terraform/*

# .tfstate files (contains sensitive infrastructure secrets and state tracking)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files (likely to contain sensitive data like passwords or API keys)
*.tfvars
*.tfvars.json

# Ignore override files (used for temporary local modifications)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore plan outputs (can contain sensitive state information)
*tfplan*
